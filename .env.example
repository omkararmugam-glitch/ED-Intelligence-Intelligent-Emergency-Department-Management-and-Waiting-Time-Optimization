# Copy to .env and edit. `.env` is gitignored; this file is not.
#
#   Copy-Item .env.example .env
#
# docker-compose.yml reads .env automatically. Nothing in here is a secret -- this
# stack has no credentials of any kind -- but .env stays out of version control so
# one machine's limits do not become everyone's.

# ----------------------------------------------------------------- the API

# Where the API binds INSIDE its container. 0.0.0.0 is correct here: the port is
# published to the host loopback only, which docker-compose.yml decides. Changing
# this to 127.0.0.1 makes the service unreachable from the dashboard container.
ED_API_HOST=0.0.0.0
ED_API_PORT=8000

# Which address on the HOST the API is published on. Loopback by default. See the
# README before changing it: the optional key below is a shared secret over plain
# HTTP, not a reason to publish this service to a network.
ED_API_PUBLISH_HOST=127.0.0.1

# OPTIONAL shared secret. Leave it UNSET (or empty) and the API is open exactly as
# it always was -- that is the default and every other setting here assumes it.
#
# Set it and every endpoint except /health and the docs requires the header
#     X-API-Key: <this value>
# The dashboard reads the same variable and sends the header for you, so one value
# here configures both containers.
#
# What this is: enough to stop anything that finds the port from querying the
# service. What it is NOT: an access-control system. One key for all callers, no
# rotation, no revocation, no rate limiting, and no TLS -- over plain HTTP the header
# travels in clear text. Treat a leak as a full compromise and change the value.
# ED_API_KEY=

# ----------------------------------------------------------- the dashboard

ED_APP_HOST=0.0.0.0
ED_APP_PORT=8501
ED_APP_PUBLISH_HOST=127.0.0.1

# How the dashboard reaches the API. The compose service name, not localhost:
# inside the container network, localhost is the dashboard itself.
ED_API_BASE_URL=http://api:8000

# Seconds before the dashboard gives up on an API call. A simulation run is slow.
ED_API_TIMEOUT=60
#
# The dashboard reads ED_API_KEY from this same file; it needs no separate setting.

# ------------------------------------------------- upload workflow limits
#
# These default to configs/default.yaml. Set them here to tighten or loosen the
# caps without editing a file inside an image. A value that is not a positive
# number is ignored and logged, and the configured default is kept.

# 50 MB. Refused before the file is parsed.
ED_UPLOAD_MAX_BYTES=52428800
# Refused before the file is parsed.
ED_UPLOAD_MAX_ROWS=500000
# Jobs allowed to wait behind the one that is running.
ED_UPLOAD_MAX_QUEUE=4
# Any single pipeline stage.
ED_UPLOAD_STAGE_TIMEOUT_SECONDS=1800
# The whole job.
ED_UPLOAD_TOTAL_TIMEOUT_SECONDS=5400
# Oldest run folders are deleted beyond this count.
ED_UPLOAD_MAX_RUNS=10
# A run folder is deleted this long after the job ends, uploaded file included.
ED_UPLOAD_RETENTION_HOURS=24

# Where run folders live inside the container. This is the writable volume; the
# rest of the container filesystem is read-only.
ED_RUNS_DIR=/app/runs
